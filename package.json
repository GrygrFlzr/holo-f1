{
	"name": "holo-f1",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply holo-f1 --local",
		"db:migrate:remote": "wrangler d1 migrations apply holo-f1 --remote",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/titillium-web": "^5.3.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "~22.16.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^4.1.12",
		"wrangler": "^4.158.0"
	},
	"engines": {
		"node": "~24.22"
	},
	"packageManager": "pnpm@12.18.0"
}
